#!/usr/bin/env bash
# Emit the most recently played installed Steam games as TSV, newest first.
#
#   appid <TAB> name <TAB> lastPlayed(epoch) <TAB> minutes <TAB> coverPath
#
# Everything comes from files Steam already keeps on disk, so this works
# offline and needs no API key. Deliberately limited to coreutils + awk:
# a shell plugin should not drag a language runtime into the bar.
set -uo pipefail

limit="${1:-5}"
[[ "${limit}" =~ ^[0-9]+$ ]] || limit=5

steam_root() {
  local candidate
  for candidate in "${HOME}/.steam/steam" "${HOME}/.local/share/Steam" \
                   "${HOME}/.var/app/com.valvesoftware.Steam/data/Steam"; do
    if [[ -d "${candidate}" ]]; then
      printf '%s\n' "${candidate}"
      return 0
    fi
  done
  return 1
}

root=""
root="$(steam_root)" || exit 0
cache="${root}/appcache/librarycache"

# Every steamapps dir Steam knows about, including games on other drives.
libraries() {
  printf '%s\n' "${root}/steamapps"
  local vdf="${root}/steamapps/libraryfolders.vdf"
  [[ -f "${vdf}" ]] || return 0
  awk -F'"' '/"path"/ { print $4 "/steamapps" }' "${vdf}"
}

# Playtime totals live per-account, not per-install. Sum is wrong (the same
# game on two accounts is not twice the hours), so take the highest.
playtimes() {
  local cfg
  for cfg in "${root}"/userdata/*/config/localconfig.vdf; do
    [[ -f "${cfg}" ]] || continue
    awk '
      /"[Aa]pps"/ && $0 ~ /^\s*"[Aa]pps"\s*$/ { appsDepth = depth + 1 }
      /^[[:space:]]*\{/ { depth++; next }
      /^[[:space:]]*\}/ { depth--; if (depth < appsDepth) appsDepth = -1; next }
      {
        if (match($0, /^[[:space:]]*"([0-9]+)"[[:space:]]*$/, m) && depth == appsDepth)
          app = m[1]
        else if (app != "" && match($0, /"Playtime"[[:space:]]+"([0-9]+)"/, m))
          print app "\t" m[1]
      }
    ' "${cfg}" 2>/dev/null
  done
}

# Compat tools and runtimes sit in steamapps beside real games. The manifest
# carries no type field, so they are matched by name.
not_a_game='^(Proton|Steam Linux Runtime|Steamworks Common Redistributables|SteamVR|Steam Controller)'

# Collected up front rather than piped straight in, so the loop below is not
# reading from a process substitution whose exit status would go unseen.
library_list=""
library_list="$(libraries)"

library_dirs=()
while IFS= read -r line; do
  [[ -n "${line}" ]] && library_dirs+=("${line}")
done <<< "${library_list}"

collect() {
  playtimes | awk -F'\t' '
    { if ($2 > t[$1]) t[$1] = $2 }
    END { for (a in t) print "T\t" a "\t" t[a] }
  '

  local lib manifest
  for lib in "${library_dirs[@]}"; do
    [[ -d "${lib}" ]] || continue
    for manifest in "${lib}"/appmanifest_*.acf; do
      [[ -f "${manifest}" ]] || continue
      awk -F'"' '
        /"appid"/      && appid  == "" { appid  = $4 }
        /"name"/       && name   == "" { name   = $4 }
        /"LastPlayed"/ && played == "" { played = $4 }
        END { if (appid != "" && name != "") print "G\t" appid "\t" name "\t" (played == "" ? 0 : played) }
      ' "${manifest}"
    done
  done
}

collect | awk -F'\t' -v skip="${not_a_game}" '
  $1 == "T" { mins[$2] = $3; next }
  $1 == "G" {
    if ($3 ~ skip) next
    # A game installed in two libraries appears twice; keep the later play.
    if ($2 in played && played[$2] >= $4) next
    played[$2] = $4; name[$2] = $3
  }
  END {
    for (a in name) printf "%s\t%s\t%s\t%s\n", played[a], a, name[a], (a in mins ? mins[a] : 0)
  }
' | sort -rn -k1,1 | head -n "${limit}" | while IFS=$'\t' read -r played appid name mins; do
  cover=""
  for art in library_600x900.jpg header.jpg; do
    if [[ -f "${cache}/${appid}/${art}" ]]; then
      cover="${cache}/${appid}/${art}"
      break
    fi
  done
  printf '%s\t%s\t%s\t%s\t%s\n' "${appid}" "${name}" "${played}" "${mins}" "${cover}"
done
