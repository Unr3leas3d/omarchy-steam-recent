#!/usr/bin/env bash
# Emit the most recently played installed Steam games as TSV, newest first.
#
#   appid <TAB> name <TAB> lastPlayed(epoch) <TAB> minutes <TAB> coverPath
#
# Everything comes from files Steam already keeps on disk, so this works
# offline and needs no API key. Deliberately limited to coreutils + awk:
# a shell plugin should not drag a language runtime into the bar.
#
# SECURITY: every field here originates in a file any local process can
# rewrite — steamapps/*.acf is not privileged. The appid in particular is
# concatenated into a shell command by the caller, so it is validated as
# digits here and again at the point of use. Sizes are bounded at every
# stage: a hostile or corrupt manifest must not be able to hand the
# long-lived shell process an unbounded string.
set -uo pipefail

limit="${1:-5}"
[[ "${limit}" =~ ^[0-9]+$ ]] || limit=5
(( limit > 50 )) && limit=50

# Ceilings. Real manifests are a few KB and real appids are under ten digits;
# these are orders of magnitude above anything legitimate.
readonly MAX_MANIFEST_BYTES=$((1024 * 1024))
readonly MAX_LOCALCONFIG_BYTES=$((32 * 1024 * 1024))
readonly MAX_MANIFESTS=2000
readonly MAX_LINE=4096
readonly MAX_APPID_DIGITS=12
readonly MAX_NAME_CHARS=200
readonly MAX_OUTPUT_BYTES=$((64 * 1024))

steam_root() {
  local candidate
  for candidate in "${HOME}/.steam/steam" "${HOME}/.local/share/Steam" \
                   "${HOME}/.var/app/com.valvesoftware.Steam/data/Steam"; do
    if [[ -d "${candidate}" ]]; then
      printf '%s\n' "${candidate}"
      return 0
    fi
  done
  return 1
}

root=""
root="$(steam_root)" || exit 0
cache="${root}/appcache/librarycache"

# Every steamapps dir Steam knows about, including games on other drives.
libraries() {
  printf '%s\n' "${root}/steamapps"
  local vdf="${root}/steamapps/libraryfolders.vdf"
  [[ -f "${vdf}" ]] || return 0
  head -c "${MAX_MANIFEST_BYTES}" "${vdf}" 2>/dev/null \
    | awk -v maxline="${MAX_LINE}" -F'"' '
        length($0) > maxline { next }
        /"path"/ { print $4 "/steamapps" }
      '
}

# Playtime totals live per-account, not per-install. Sum is wrong (the same
# game on two accounts is not twice the hours), so take the highest.
playtimes() {
  local cfg
  for cfg in "${root}"/userdata/*/config/localconfig.vdf; do
    [[ -f "${cfg}" ]] || continue
    head -c "${MAX_LOCALCONFIG_BYTES}" "${cfg}" 2>/dev/null | awk -v maxline="${MAX_LINE}" -v maxdigits="${MAX_APPID_DIGITS}" '
      length($0) > maxline { next }
      /"[Aa]pps"/ && $0 ~ /^\s*"[Aa]pps"\s*$/ { appsDepth = depth + 1 }
      /^[[:space:]]*\{/ { depth++; next }
      /^[[:space:]]*\}/ { depth--; if (depth < appsDepth) appsDepth = -1; next }
      {
        if (match($0, /^[[:space:]]*"([0-9]+)"[[:space:]]*$/, m) && depth == appsDepth) {
          app = (length(m[1]) <= maxdigits) ? m[1] : ""
        } else if (app != "" && match($0, /"Playtime"[[:space:]]+"([0-9]+)"/, m)) {
          if (length(m[1]) <= 12) print app "\t" m[1]
        }
      }
    ' 2>/dev/null
  done
}

# Compat tools and runtimes sit in steamapps beside real games. The manifest
# carries no type field, so they are matched by name.
not_a_game='^(Proton|Steam Linux Runtime|Steamworks Common Redistributables|SteamVR|Steam Controller)'

library_list=""
library_list="$(libraries)"

library_dirs=()
while IFS= read -r line; do
  [[ -n "${line}" ]] && library_dirs+=("${line}")
done <<< "${library_list}"

collect() {
  playtimes | awk -F'\t' '
    { if ($2 > t[$1]) t[$1] = $2 }
    END { for (a in t) print "T\t" a "\t" t[a] }
  '

  local lib manifest scanned=0
  for lib in "${library_dirs[@]}"; do
    [[ -d "${lib}" ]] || continue
    for manifest in "${lib}"/appmanifest_*.acf; do
      [[ -f "${manifest}" ]] || continue
      (( scanned++ >= MAX_MANIFESTS )) && break 2
      head -c "${MAX_MANIFEST_BYTES}" "${manifest}" 2>/dev/null | awk -F'"' \
        -v maxline="${MAX_LINE}" -v maxdigits="${MAX_APPID_DIGITS}" -v maxname="${MAX_NAME_CHARS}" '
        length($0) > maxline { next }
        /"appid"/      && appid  == "" { appid  = $4 }
        /"name"/       && name   == "" { name   = $4 }
        /"LastPlayed"/ && played == "" { played = $4 }
        END {
          # An appid reaches a shell command downstream. Anything that is not
          # a short run of digits is dropped outright rather than escaped.
          if (appid !~ /^[0-9]+$/ || length(appid) > maxdigits) exit
          if (played !~ /^[0-9]+$/ || length(played) > 12) played = 0
          # The name is display-only, but it shares a tab-delimited line with
          # the appid, so separators and control characters have to go.
          gsub(/[\t\r\n\x00-\x1f]/, " ", name)
          if (name == "") exit
          if (length(name) > maxname) name = substr(name, 1, maxname)
          print "G\t" appid "\t" name "\t" (played == "" ? 0 : played)
        }
      ' 2>/dev/null
    done
  done
}

collect | awk -F'\t' -v skip="${not_a_game}" '
  $1 == "T" { mins[$2] = $3; next }
  $1 == "G" {
    if ($3 ~ skip) next
    # A game installed in two libraries appears twice; keep the later play.
    if ($2 in played && played[$2] >= $4) next
    played[$2] = $4; name[$2] = $3
  }
  END {
    for (a in name) printf "%s\t%s\t%s\t%s\n", played[a], a, name[a], (a in mins ? mins[a] : 0)
  }
' | sort -rn -k1,1 | head -n "${limit}" | while IFS=$'\t' read -r played appid name mins; do
  # Belt and braces: nothing that is not digits gets past here either.
  [[ "${appid}" =~ ^[0-9]{1,12}$ ]] || continue
  [[ "${played}" =~ ^[0-9]{1,12}$ ]] || played=0
  [[ "${mins}" =~ ^[0-9]{1,12}$ ]] || mins=0
  cover=""
  for art in library_600x900.jpg header.jpg; do
    if [[ -f "${cache}/${appid}/${art}" ]]; then
      cover="${cache}/${appid}/${art}"
      break
    fi
  done
  printf '%s\t%s\t%s\t%s\t%s\n' "${appid}" "${name}" "${played}" "${mins}" "${cover}"
done | head -c "${MAX_OUTPUT_BYTES}"
